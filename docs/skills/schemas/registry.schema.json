{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Star Splitter Skill Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "registryVersion",
    "state",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "registryVersion": {
      "type": "string"
    },
    "state": {
      "enum": [
        "candidate",
        "stable"
      ]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "path",
          "intents",
          "applicability",
          "dependencies",
          "nonTriggers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(img|reference-keeper|rexprompt|visions|collaboration)-[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "stable",
              "experimental",
              "deprecated"
            ]
          },
          "path": {
            "type": "string"
          },
          "intents": {
            "type": "array",
            "minItems": 1
          },
          "applicability": {
            "type": "array"
          },
          "dependencies": {
            "type": "array"
          },
          "nonTriggers": {
            "type": "array"
          }
        }
      }
    }
  }
}
