      },
      "grade": {
        "autoNormalize": false,
        "flagLuminanceDifference": 35,
        "flagSaturationDifference": 45,
        "requireIntentionalDifferenceReview": true
      },
      "geometry": {
        "rasterSource": "complete-trim-plus-bleed-if-page-is-full-bleed",
        "noUpscaling": true,
        "coverWrap": "requires-separate-printer-spec",
        "safeAreaNotAutomaticCrop": true
      }
    }
  },
  "seriesProfiles": {
    "rex-fleet": "standard-us-comic-print-v1",
    "vikings-2026": "standard-us-comic-print-v1",
    "stardust-station": "standard-us-comic-print-v1"
  },
  "additionalSeriesPolicy": "select-explicit-profile-before-mastering; all series use the same mandatory gate schema"
