{
  "schemaVersion": 1,
  "description": "Working production targets. Printer-specific ICC, cover wrap, trim approval and print signoff must be separately verified. Do not infer approval from this configuration.",
  "profiles": {
    "standard-us-comic-print-v1": {
      "status": "working-target-not-printer-approved",
      "medium": "print",
      "trimInches": {
        "width": 6.625,
        "height": 10.25
      },
      "bleedInches": 0.125,
      "safeInches": 0.25,
      "minNativeDpi": 300,
      "aspectTolerance": 0.03,
      "color": {
        "reviewWorkingSpace": "sRGB IEC61966-2.1",
        "pressOutputICC": "unresolved",
        "pressIntent": "requires-printer-confirmation",
        "renderingIntent": "relative-colorimetric-with-black-point-compensation-if-printer-approved",
