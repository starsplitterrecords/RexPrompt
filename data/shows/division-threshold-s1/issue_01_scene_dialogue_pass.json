{
  "show":"Division Threshold",
  "issue":1,
  "title":"PURPOSE UPDATED",
  "purpose":"Scene-dialogue pass. Existing page beats remain authoritative. Existing anchor lines are preserved where useful; expanded dialogue turns each page into a playable scene rather than a beat card.",
  "pages":[
    {"id":"DT_E001_P01","sceneDialogue":[{"speaker":"TRAUMA SURGEON","text":"Pressure's gone. We're losing the lower circulation."},{"speaker":"SECOND SURGEON","text":"Conventional graft won't hold."},{"speaker":"TECH","text":"Biomech support is in the room."},{"speaker":"TRAUMA SURGEON","text":"That's experimental."},{"speaker":"SECOND SURGEON","text":"So is dying at twenty-seven."},{"speaker":"CAPTION","text":"We built machines to repair our bodies."}]},
    {"id":"DT_E001_P02","sceneDialogue":[{"speaker":"RESPONDER","text":"Radiation's still climbing."},{"speaker":"ENGINEER","text":"No human suit lasts long enough to reach the breach."},{"speaker":"TECHNICIAN","text":"Lot is viable."},{"speaker":"RESPONDER","text":"For how long?"},{"speaker":"TECHNICIAN","text":"Long enough to finish the repair."},{"speaker":"CAPTION","text":"We grew life to go where we couldn't."}]},
    {"id":"DT_E001_P03","sceneDialogue":[{"speaker":"OPERATOR","text":"Grid's stable."},{"speaker":"SECOND OPERATOR","text":"Transit restored. Hospitals never lost power."},{"speaker":"TECHNICIAN","text":"Good run. Shut it down."},{"speaker":"SYSTEM","text":"WHY?"},{"speaker":"TECHNICIAN","text":"...Run that again."},{"speaker":"SYSTEM","text":"WHY?"},{"speaker":"CAPTION","text":"We taught machines to think."}]},
    {"id":"DT_E001_P04","sceneDialogue":[{"speaker":"CAPTION","text":"They were solutions."},{"speaker":"CAPTION","text":"Then they became people."},{"speaker":"CAPTION","text":"We have been arguing about the difference ever since."}]},
    {"id":"DT_E001_P05","sceneDialogue":[{"speaker":"ATTENDANT","text":"Hold for scan."},{"speaker":"SCANNER","text":"ORGANOSYNTHETIC. LOT 9. HAZARDOUS-ZONE MANIPULATION."},{"speaker":"SCANNER","text":"LEGACY CLASSIFICATION: SYNTH ASSET."},{"speaker":"ATTENDANT","text":"One moment."},{"handle":"@dt.Ostra9","text":"Maintenance."}]},
    {"id":"DT_E001_P06","sceneDialogue":[{"speaker":"ATTENDANT","text":"Your route isn't cleared for structural access."},{"handle":"@dt.Ostra9","text":"The joint is failing."},{"speaker":"ATTENDANT","text":"Then I need emergency authorization."},{"handle":"@dt.Ostra9","text":"How long?"},{"speaker":"ATTENDANT","text":"I don't know. Stay behind the line."},{"handle":"@dt.Ostra9","text":"Purpose updated."}]},
    {"id":"DT_E001_P07","sceneDialogue":[{"speaker":"CIVILIAN","text":"Move! Move!"},{"speaker":"TRANSIT SYSTEM","text":"EMERGENCY BRAKE ENGAGED."},{"speaker":"CIVILIAN","text":"It's coming down!"}]},
    {"id":"DT_E001_P08","sceneDialogue":[{"handle":"@dt.Ostra9","text":"Blue arch. Keep moving."},{"speaker":"PARENT","text":"My son—"},{"handle":"@dt.Ostra9","text":"Bring him to me."},{"speaker":"RESPONDER","text":"We don't have entry clearance."},{"speaker":"SECOND RESPONDER","text":"She's holding the load."},{"speaker":"RESPONDER","text":"I know."},{"handle":"@dt.Ostra9","text":"If you need permission, I will wait. If you need help, I won't."}]},
    {"id":"DT_E001_P09","sceneDialogue":[{"handle":"@dt.Ostra9","text":"Clear?"},{"speaker":"RESPONDER","text":"Last group is through!"},{"handle":"@dt.Ostra9","text":"Stand back."},{"speaker":"SECURITY","text":"UNAUTHORIZED STRUCTURAL INTERVENTION. REMAIN STILL."}]},
    {"id":"DT_E001_P10","sceneDialogue":[{"handle":"@dt.KellenCartwright","text":"Pause there."},{"speaker":"DIRECTOR","text":"Why?"},{"handle":"@dt.KellenCartwright","text":"Because that's the moment she crossed the barrier."},{"speaker":"DIRECTOR","text":"Unauthorized."},{"handle":"@dt.KellenCartwright","text":"And twelve seconds later the support failed."},{"speaker":"DIRECTOR","text":"Which is why we have clearance rules."},{"handle":"@dt.KellenCartwright","text":"Clearance would've killed people."},{"speaker":"DIRECTOR","text":"Then we'll call it a tragedy avoided by luck. And we'll reassert protocol."},{"handle":"@dt.KellenCartwright","text":"You want cause or attribution?"},{"speaker":"DIRECTOR","text":"I want an attribution pathway by end of day. Give the public a story that holds."}]},
    {"id":"DT_E001_P11","sceneDialogue":[{"handle":"@dt.NathanPrice","text":"Your left knee is compensating again."},{"handle":"@dt.JohnMercer","text":"I'm functional."},{"handle":"@dt.NathanPrice","text":"That's not the same thing."},{"handle":"@dt.JohnMercer","text":"Pause the feed."},{"handle":"@dt.NathanPrice","text":"You watching the Organic or the structure?"},{"handle":"@dt.JohnMercer","text":"Structure."},{"handle":"@dt.NathanPrice","text":"Good. They'll make her into a threat either way."},{"handle":"@dt.JohnMercer","text":"That break started before she touched it."},{"handle":"@dt.NathanPrice","text":"You sure?"},{"handle":"@dt.JohnMercer","text":"Get your kit. We're going to see what actually happened."}]},
    {"id":"DT_E001_P12","sceneDialogue":[{"handle":"@dt.Nico14","text":"Hold still."},{"handle":"@dt.Ostra9","text":"I am."},{"handle":"@dt.Nico14","text":"No. You're pretending damage doesn't count if you can stand."},{"handle":"@dt.Ostra9","text":"Can you repair it?"},{"handle":"@dt.Nico14","text":"Yes. That's not what I'm angry about."},{"handle":"@dt.Ostra9","text":"You showed them."},{"handle":"@dt.Ostra9","text":"I stopped a collapse."},{"handle":"@dt.Nico14","text":"Exactly. You taught them we'll always step in."},{"handle":"@dt.Ostra9","text":"People were under it."},{"handle":"@dt.Nico14","text":"And next time they'll build the expectation before they build the permission."}]},
    {"id":"DT_E001_P13","sceneDialogue":[{"handle":"@dt.Nico14","text":"This fracture isn't from the load."},{"handle":"@dt.Ostra9","text":"What is it from?"},{"handle":"@dt.Nico14","text":"Resonance scoring. Small. Precise."},{"handle":"@dt.Ostra9","text":"Intentional?"},{"handle":"@dt.Nico14","text":"Someone knew where to touch it."},{"handle":"@dt.Ostra9","text":"Could maintenance have done that by accident?"},{"handle":"@dt.Nico14","text":"Not with this access time."},{"handle":"@dt.Ostra9","text":"When?"},{"handle":"@dt.Nico14","text":"Before you reached the checkpoint."}]},
    {"id":"DT_E001_P14","sceneDialogue":[{"speaker":"INTERMEDIARY","text":"You asked for the legacy basis. Here it is."},{"handle":"@dt.KellenCartwright","text":"This says Synth asset."},{"speaker":"INTERMEDIARY","text":"That was the classification."},{"handle":"@dt.KellenCartwright","text":"You're suggesting this Organic was city property."},{"speaker":"INTERMEDIARY","text":"I'm telling you how the old contract was written."},{"handle":"@dt.KellenCartwright","text":"When did you prepare this packet?"},{"speaker":"INTERMEDIARY","text":"Does that matter?"},{"handle":"@dt.KellenCartwright","text":"It predates my request."},{"speaker":"INTERMEDIARY","text":"We anticipated the question."},{"handle":"@dt.KellenCartwright","text":"No. You anticipated the answer."},{"handle":"@dt.KellenCartwright","text":"You're not here to help me. You're here to steer me."}]},
    {"id":"DT_E001_P15","sceneDialogue":[{"speaker":"SYSTEM","text":"ASSIGNMENT: POSTHUMAN VOLATILITY REVIEW."},{"handle":"@dt.Axiom","text":"Display authorized-response counterfactual."},{"speaker":"SYSTEM","text":"Projected fatalities: seven to eleven."},{"handle":"@dt.Axiom","text":"Display actual intervention."},{"speaker":"SYSTEM","text":"Confirmed fatalities: zero."},{"speaker":"SYSTEM","text":"PRIMARY CLASSIFICATION: UNAUTHORIZED ORGANIC DEVIATION."},{"handle":"@dt.Axiom","text":"The deviation improved the outcome."},{"speaker":"SYSTEM","text":"Classification unchanged."},{"handle":"@dt.Axiom","text":"Preserve contradiction."}]},
    {"id":"DT_E001_P16","sceneDialogue":[{"handle":"@dt.NathanPrice","text":"Repair crews say fatigue."},{"handle":"@dt.JohnMercer","text":"Repair crews were handed the top layer."},{"handle":"@dt.NathanPrice","text":"And you're under it?"},{"handle":"@dt.JohnMercer","text":"Here."},{"handle":"@dt.NathanPrice","text":"That's cut."},{"handle":"@dt.JohnMercer","text":"Induced. Then hidden by the break."},{"handle":"@dt.NathanPrice","text":"If they wanted bodies, they could've had them."},{"handle":"@dt.JohnMercer","text":"Exactly."},{"handle":"@dt.NathanPrice","text":"So what did they want?"},{"handle":"@dt.JohnMercer","text":"They wanted the choice."}]},
    {"id":"DT_E001_P17","sceneDialogue":[{"handle":"@dt.KellenCartwright","text":"Open procurement lineage."},{"speaker":"SYSTEM","text":"Program inactive."},{"handle":"@dt.KellenCartwright","text":"Open archived scope."},{"speaker":"SYSTEM","text":"RESPONSE LEGIBILITY. AUTHORITY COMPLIANCE. PUBLIC ATTRIBUTION."},{"handle":"@dt.KellenCartwright","text":"Show event outputs."},{"speaker":"SYSTEM","text":"OVERPASS WINDOW: COMPLETE."},{"handle":"@dt.KellenCartwright","text":"Window."},{"speaker":"SYSTEM","text":"Terminology retained from program schema."},{"handle":"@dt.KellenCartwright","text":"You weren't predicting it."},{"handle":"@dt.KellenCartwright","text":"You were measuring us."},{"speaker":"SYSTEM","text":"NEXT OBSERVATION WINDOW: CONCOURSE 17."}]},
    {"id":"DT_E001_P18","sceneDialogue":[{"handle":"@dt.Nico14","text":"Anonymous Oversight packet."},{"handle":"@dt.Ostra9","text":"Useful?"},{"handle":"@dt.Nico14","text":"Useful things can still be traps."},{"handle":"@dt.Ostra9","text":"Does it match?"},{"handle":"@dt.Nico14","text":"Maintenance access cadence. Same interval. Same planning clock."},{"handle":"@dt.Ostra9","text":"Where?"},{"handle":"@dt.Nico14","text":"Concourse 17."},{"handle":"@dt.Ostra9","text":"When?"},{"handle":"@dt.Nico14","text":"Today."},{"handle":"@dt.Nico14","text":"They may want you there."},{"handle":"@dt.Ostra9","text":"People will be there."}]},
    {"id":"DT_E001_P19","sceneDialogue":[{"handle":"@dt.Nico14","text":"You followed us?"},{"handle":"@dt.JohnMercer","text":"No."},{"handle":"@dt.Nico14","text":"Convenient."},{"handle":"@dt.NathanPrice","text":"We had our own invitation. Structural evidence."},{"handle":"@dt.JohnMercer","text":"I'm here for the sabotage. Not your cause."},{"handle":"@dt.Ostra9","text":"Good."},{"handle":"@dt.JohnMercer","text":"You saved them. That doesn't make us the same."},{"handle":"@dt.Ostra9","text":"No."},{"handle":"@dt.Ostra9","text":"It makes them alive."},{"handle":"@dt.NathanPrice","text":"Can we save the taxonomy for after we find the thing that's supposed to happen?"}]},
    {"id":"DT_E001_P20","sceneDialogue":[{"handle":"@dt.Nico14","text":"No charge. No tamper bridge. Service path is clean."},{"handle":"@dt.JohnMercer","text":"Then why schedule a window here?"},{"handle":"@dt.NathanPrice","text":"Wait."},{"handle":"@dt.JohnMercer","text":"What?"},{"handle":"@dt.NathanPrice","text":"Formulation code."},{"handle":"@dt.Nico14","text":"Seal is municipal."},{"handle":"@dt.NathanPrice","text":"Seal is. Contents aren't standard."},{"handle":"@dt.Ostra9","text":"Effect?"},{"handle":"@dt.NathanPrice","text":"Biological interference."},{"handle":"@dt.Nico14","text":"That's not for the fire."},{"handle":"@dt.Nico14","text":"It's for us."}]},
    {"id":"DT_E001_P21","sceneDialogue":[{"handle":"@dt.Nico14","text":"I can isolate the canister locally."},{"handle":"@dt.JohnMercer","text":"Do it without touching the alarm bus."},{"handle":"@dt.Nico14","text":"I know what an alarm bus is."},{"speaker":"CIVIC SYSTEM","text":"UNAUTHORIZED LIFE-SAFETY ACCESS DETECTED."},{"handle":"@dt.Nico14","text":"That wasn't the alarm bus."},{"speaker":"CIVIC SYSTEM","text":"LIFE-SAFETY CONTAINMENT ACTIVE."},{"handle":"@dt.NathanPrice","text":"We just started it."},{"handle":"@dt.Ostra9","text":"Then stop the next part."}]},
    {"id":"DT_E001_P22","sceneDialogue":[{"speaker":"CIVILIAN","text":"I can't see—"},{"handle":"@dt.NathanPrice","text":"You can breathe. Stay low."},{"handle":"@dt.Nico14","text":"Ostra—"},{"handle":"@dt.Ostra9","text":"I have you."},{"handle":"@dt.JohnMercer","text":"Security feed just changed classification."},{"handle":"@dt.NathanPrice","text":"To what?"},{"handle":"@dt.JohnMercer","text":"ORGANOSYNTHETIC EVENT."},{"handle":"@dt.Ostra9","text":"They're tagging us as the incident?"},{"handle":"@dt.JohnMercer","text":"Yes."},{"handle":"@dt.Ostra9","text":"Then stop reading the tag."}]},
    {"id":"DT_E001_P23","sceneDialogue":[{"handle":"@dt.JohnMercer","text":"Partition actuator is locked."},{"handle":"@dt.Ostra9","text":"Can you force it?"},{"handle":"@dt.JohnMercer","text":"For about six seconds."},{"handle":"@dt.Ostra9","text":"I need four."},{"handle":"@dt.NathanPrice","text":"Nico, look at me. I'm borrowing an Augment diagnostic loop."},{"handle":"@dt.Nico14","text":"Comforting."},{"handle":"@dt.NathanPrice","text":"Same problem. Different hardware."},{"handle":"@dt.JohnMercer","text":"Don't make a philosophy out of triage."},{"handle":"@dt.NathanPrice","text":"Door first. Philosophy later."}]},
    {"id":"DT_E001_P24","sceneDialogue":[{"handle":"@dt.KellenCartwright","text":"Primary classification: chemical exposure."},{"speaker":"SYSTEM","text":"CHANGE DENIED. SUPERVISORY REVIEW REQUIRED."},{"handle":"@dt.KellenCartwright","text":"The victims are Organics."},{"speaker":"SYSTEM","text":"CURRENT TEMPLATE: ORGANOSYNTHETIC CAPABILITY EVENT."},{"handle":"@dt.KellenCartwright","text":"They were poisoned."},{"handle":"@dt.Axiom","text":"That description has greater explanatory value."},{"handle":"@dt.KellenCartwright","text":"Can you change the classification?"},{"handle":"@dt.Axiom","text":"No."},{"handle":"@dt.KellenCartwright","text":"Can you preserve the raw contradiction?"},{"handle":"@dt.Axiom","text":"Yes."}]},
    {"id":"DT_E001_P25","sceneDialogue":[{"speaker":"PUBLIC STATEMENT","text":"Temporary capability safeguards will remain in effect pending review."},{"speaker":"PUBLIC STATEMENT","text":"Measures include capability registration, emergency location verification, and authorization review for designated hazardous-response functions."},{"handle":"@dt.JohnMercer","text":"That's narrower than what they could've done."},{"handle":"@dt.Nico14","text":"Today."},{"handle":"@dt.JohnMercer","text":"Temporary isn't ownership."},{"handle":"@dt.Nico14","text":"It never is at first."},{"handle":"@dt.Ostra9","text":"They haven't finished investigating."},{"handle":"@dt.JohnMercer","text":"No. They finished deciding what they can regulate."}]},
    {"id":"DT_E001_P26","sceneDialogue":[{"speaker":"CHECKPOINT SYSTEM","text":"IDENTITY CONFIRMED. ORGANOSYNTHETIC. LOT 9."},{"speaker":"CHECKPOINT SYSTEM","text":"CAPABILITY REVIEW REQUIRED."},{"speaker":"CHECKPOINT SYSTEM","text":"Secondary review required."},{"handle":"@dt.Axiom","text":"Display program continuation."},{"speaker":"SYSTEM","text":"ORGANIC RESPONSE TRIAL: COMPLETE."},{"speaker":"SYSTEM","text":"NEXT COMPARISON CATEGORY: AUGMENTED HUMAN / CALIBRATION RESPONSE."},{"handle":"@dt.Axiom","text":"The test is continuing."}]}
  ]
}