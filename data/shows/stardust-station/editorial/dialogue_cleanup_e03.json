[
  {
    "id": "SDS_S1E03_P03",
    "dialogueInline": [
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "I added meeting-efficiency metrics.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Are any of those pretending to know what we're thinking?",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "I am counting actions only.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "You gave the meeting a scoreboard.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P04",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "For the follow-ups, I need names.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Happy to advise.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "You're already here.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Can advisory capacity hold this for thirty seconds?",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Fine. Hand it over.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P05",
    "dialogueInline": [
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "An owner is the person whose name stays on the task after we leave.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Assuming they agreed to it.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "I need something we can use before the meeting ends.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "A named person who accepts the task.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "They know it's theirs before the meeting ends.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P06",
    "dialogueInline": [
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Same buildup as yesterday. More pressure, more residue. Could just be heat, paper, static.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Everyone's quiet, but nobody's relaxed.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Yeah. Still doesn't mean the dust can read.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "I can preserve that distinction.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P10",
    "dialogueInline": [
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "It's gone up over time, especially when we keep stopping and starting.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Correlation is positive.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "No new science project.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Not a project. And it's not reacting to the word 'owner.'",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "We keep stopping before the work starts.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Stop sampling for today.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P11",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Pixa, hide the dashboard.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "The counts continue.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "The witness left the room.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Keep counting in the background.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P14",
    "dialogueInline": [
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "If it matters, someone has to leave knowing it's theirs.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "And agree before we leave.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "That's the rule.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Metric updated to match the rule.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P16",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "We're done. We have enough to go do the work.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Two agenda items are still unresolved.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Then they stay unresolved.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P17",
    "dialogueInline": [
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "We can't close with blank owner fields.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Then leave them blank until somebody actually takes them.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Leaving them blank creates an administrative exposure.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Assigning them falsely would be worse.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Closure recorded without pretending completion.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P18",
    "dialogueInline": [
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "There. I have a wall again.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Date first. Apparently that's mine now.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Residue is stable.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P19",
    "dialogueInline": [
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Loose bracket. Ten-minute job.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "The label is also wrong by one digit.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Fix the label while I'm on the bracket.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Repair remains within original estimate.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P20",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "You finished it.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I'm trying this new thing where I just finish the small stuff.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Keep doing that.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Any new buildup?",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Nothing new on the sensor.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E03_P22",
    "dialogueInline": [
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Two open items remain.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Do not reopen the meeting.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "The work is already in progress.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "This result is statistically unusual.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Let it stay unusual.",
        "subtext": "Panel 5"
      }
    ]
  }
]
