[
  {
    "id": "SDS_S1E07_P05",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Three new entries. Three different requested outcomes.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Keep all three outcomes separate.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Hatch gets checked. Handoff gets reconciled.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "I want whoever actually uses both lists.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "KREEB",
        "text": "This one stays personal.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P07",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "Both lists are current.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "KREEB",
        "text": "And people use both.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "So nobody's actually ignoring the process.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "We have two processes.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Do not classify the original disclosure yet.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "Nobody mark anything.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P08",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "I think we found your department.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "BRICK",
        "text": "I have always had a department.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "The vending machine?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "BRICK",
        "text": "Hostile automation.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "No investigation unless it steals money or catches fire.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "BRICK",
        "text": "Those are crude thresholds.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P09",
    "dialogueInline": [
      {
        "speaker": "NOOLA",
        "text": "That one was mine.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "NOOLA",
        "text": "You're not going to ask what category?",
        "subtext": "Panel 1"
      },
      {
        "speaker": "KREEB",
        "text": "I don't need the category.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "NOOLA",
        "text": "I miss home. Late shift makes it worse sometimes.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "Do you want anything changed?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "NOOLA",
        "text": "I just wanted to say it somewhere.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "Then you did.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "NOOLA",
        "text": "That's all?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "That can be all.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P10",
    "dialogueInline": [
      {
        "speaker": "ZIB",
        "text": "Again.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "We just fixed it.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "Then it will work again.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "Cold condition set.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Moment of truth.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ZIB",
        "text": "Move it.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "JAX",
        "text": "Door moved.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "Clean cycle.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P12",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Six defects closed. Two process conflicts closed.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "And you're delivering furniture.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "The stool belongs over there.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "That's not your job.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Neither was blocking the doorway yesterday.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "NOOLA",
        "text": "Still miss home.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "KREEB",
        "text": "I remember.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P14",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Passive sample mass is lower than yesterday.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Lower mass. Interesting.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Could the repairs be lowering it?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "Maybe. Too small, too messy.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "Leave it indeterminate. Keep the comparison.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P15",
    "dialogueInline": [
      {
        "speaker": "KREEB",
        "text": "Do we need the no-entry count?",
        "subtext": "Panel 1"
      },
      {
        "speaker": "GLORP",
        "text": "For response rate.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "KREEB",
        "text": "There are six people on late shift. A count becomes a person pretty quickly.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "That count is too identifying.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Take it out?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Already gone.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "BRICK",
        "text": "And the vending machine?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Still unsubstantiated.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "BRICK",
        "text": "You have become difficult.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P16",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "Leave the material question open.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "No personal count.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "No personal text.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "The outgoing report has fewer categories than the source form.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "PIXA",
        "text": "The reduced report is readable.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P17",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "REMOTE INTERPRETATION INCONCLUSIVE.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "Remote review failed.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "SCREEN",
        "text": "ON-SITE OPERATIONS LIAISON RECOMMENDED.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "They're sending someone who can walk around and inspect the station.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P18",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "Visitor prep. Nobody panic.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "You're already holding the route sheet.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Because I own the route.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Visitor route owner: Jax Orien.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P19",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "PRESENTATION / SIGNAGE / VISIBLE CLUTTER / STAFF READINESS.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "Delete the presentation section.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "We're not making the station look unused.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ZIB",
        "text": "We'd need a different station.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "SCREEN",
        "text": "SAFETY HAZARDS / ACCESS / REQUIRED RECORDS.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Those stay.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Fix hazards. Clear access. Leave the rest alone.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "Finally, a visitor plan.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P20",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "Personal envelope stays here.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Material note says no behavioral predictor.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "BRICK",
        "text": "The vending-machine note stays out of the visitor packet.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "BRICK",
        "text": "The machine is smug.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "GLORP",
        "text": "Not in the visitor packet.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P21",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "VISITOR CONFIRMED: STARTRUST OPERATIONS LIAISON.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "You have checked that intersection three times.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "The bin still moves when people bump it.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Is the route clear?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "Route is clear.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P22",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "SELECTION OPTIMIZED.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "BRICK",
        "text": "I selected water.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "You received a protein bar.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "That does not establish intent.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "BRICK",
        "text": "It knew what it was doing.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Visitor arrival in eleven hours.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "BRICK",
        "text": "Tell them to bring exact change.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P02",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Participation complete.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "Would you like private confirmation?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Keep the confirmation private.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P06",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "It says when cold.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "It works now.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "It's not cold now.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "So the hatch has an alibi.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "Temporary one.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Set up the cold test.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P13",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "LOW CATEGORY COMPLETION MAY LIMIT INTERPRETABILITY.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "SCREEN",
        "text": "REQUEST: DE-IDENTIFIED DISCLOSURE THEMES / OUTPUT CORRELATION.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "We don't have the second thing.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "They are not getting the personal text to make the first thing.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "We do have routed work and completion states.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "PIXA",
        "text": "And no inferred categories.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Use only what we actually have.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Don't rebuild anyone's disclosure later.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E07_P03",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "This says the vent by Berth Three whistles all night.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ZIB",
        "text": "Finally something useful.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "It's not a feeling.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "Then somebody was awake because of it.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ZIB",
        "text": "I'm going to look.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "The initiative doesn't route maintenance.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Route it now.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "Bring the card.",
        "subtext": "Panel 4"
      }
    ]
  }
]
