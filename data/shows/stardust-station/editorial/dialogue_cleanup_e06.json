[
  {
    "id": "SDS_S1E06_P02",
    "dialogueInline": [
      {
        "speaker": "ZIB",
        "text": "Damper service. Ten minutes.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "The repair is due today.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "First open access window is eighteen-thirty.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "It's ten in the morning.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Can it wait through the first block?",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "It can wait, but the room gets warmer.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "One block. Then you get the wall.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P03",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "If I count entries only, the room can stay private.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "No names?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "No identity. No dwell time.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "And the counter stays outside.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P04",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "MINDFUL PAUSE RECORDED.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "I'm waiting for a lift.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "You are also paused.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Can I bill wellness for the delay?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Wellness does not cover lift delays.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Then this is already less relaxing.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Please don't become a case study before lunch.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P05",
    "dialogueInline": [
      {
        "speaker": "NOOLA",
        "text": "Is it always this warm in here?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "The room is warmer because I can't get to that wall.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "Quiet room is open.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "And you can use it whenever you want.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P06",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "You brought three thermometers.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Two thermometers. One airflow sensor.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Staff-condition fields are available.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "The room is already wrong. I don't need a feelings column for that.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Can we get anything useful out of this?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "The room data is usable.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "About wellness?",
        "subtext": "Panel 5"
      },
      {
        "speaker": "MIRA",
        "text": "About temperature and airflow.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P07",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Baseline block active.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ZIB",
        "text": "Damper still wants ten minutes.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "Anyone can leave.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "If you want out, go. We are not holding people hostage for wellness.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P08",
    "dialogueInline": [
      {
        "speaker": "NOOLA",
        "text": "This is too warm.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "NOOLA",
        "text": "I'm leaving.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "Door path clear.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "Three degrees up.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Three exits. Cause unassigned.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "All right. I understand this problem.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P09",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "I can stay if you need the head count.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "I don't need you sitting there for the spreadsheet.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "The baseline's already bad.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "It went bad when I made Zib wait.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "Then stop making him wait.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "End the block. Zib, take the wall.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P11",
    "dialogueInline": [
      {
        "speaker": "ZIB",
        "text": "Found it.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "That's the whole problem?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "Binding hinge.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "Cycle.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Temperature is coming down.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "Airflow too.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Use the recovered airflow as the physical baseline.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "Log the airflow. Leave wellness out of it.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P12",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "Air's moving again.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "NOOLA",
        "text": "Dome temperature is back to normal.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "NOOLA",
        "text": "The air is moving.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "There goes the wellness story.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "It was a speaker and a hot room.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "Keep me out of the report.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "JAX",
        "text": "Repair log already has you.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P13",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "These are separate fields.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "Participation and reflection may be completed separately.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Participation can be complete with reflection left blank.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Keep it that way.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P14",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "I waited for a lift, sat in a hot room, left, moved a speaker, and told nobody anything.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "NOOLA",
        "text": "I left sooner.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "Both records are complete.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P15",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "Room temperature?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "NOOLA",
        "text": "Back to normal.",
        "subtext": "Panel 2"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P16",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "Here. Before, during, repair, after.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "The room got hot.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "Three-degree rise during the block.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "People left.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "Three exits during the rise.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ZIB",
        "text": "Then I fixed the damper.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "And temperature recovered.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "You could put my name next to that.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "What about wellness?",
        "subtext": "Panel 5"
      },
      {
        "speaker": "MIRA",
        "text": "I don't know. That's not in this data.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P18",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "THANK YOU FOR THE LEARNINGS.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "SCREEN",
        "text": "LOW DISCLOSURE CONTEXT LIMITS INTERPRETABILITY.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "SCREEN",
        "text": "SUPPLEMENTAL VOLUNTARY DISCLOSURE INITIATIVE RECOMMENDED.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "We're not adding another disclosure program.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Participation is required. Disclosure remains optional.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "PIXA",
        "text": "Different program, same participation structure.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P19",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "We gave them a hot room and no disclosures, and they built another program.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "KREEB",
        "text": "We kept the opt-out.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "And I kept the airflow data.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "Mine has a graph.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P21",
    "dialogueInline": [
      {
        "speaker": "SIGN",
        "text": "NO ENTRY IS VALID.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "That stays.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "As temporary guidance?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Just leave it.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P22",
    "dialogueInline": [
      {
        "speaker": "SIGN",
        "text": "BRING YOUR FEELINGS TO WORK DAY.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "SIGN",
        "text": "PARTICIPATION REQUIRED / DISCLOSURE OPTIONAL.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "I'm leaving mine at home.",
        "subtext": "Panel 2"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P10",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Baseline block ended incomplete.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "Put it on my permanent record.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "There is no permanent wellness record.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "I've got the speaker.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Give it here.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "You volunteering?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "It's in the way.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "Best thing we've done all morning.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ZIB",
        "text": "Panel clear.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P17",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "I like this one. The room got hot and then we fixed it.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "It's readable.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Before anybody changes it, I'm sending it.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E06_P20",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "For the record: participated, disclosed nothing, moved one speaker.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "GLORP",
        "text": "All accurate.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "I'm getting used to a form that lets you leave things blank.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "I don't like it yet.",
        "subtext": "Panel 4"
      }
    ]
  }
]
