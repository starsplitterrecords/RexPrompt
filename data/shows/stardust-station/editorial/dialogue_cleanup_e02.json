[
  {
    "id": "SDS_S1E02_P01",
    "dialogueInline": [
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Why are the chairs facing the microwave?",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Nobody wanted to sit here after yesterday.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "People should know what's still out of service.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Can I just heat this up?",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "The scene has been preserved.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "It's lunch, Brick.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P02",
    "dialogueInline": [
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "What counts as processing soup as a group?",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "This, apparently.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "That's my mug.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I thought the cracked ones were communal.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "It's cracked. It's not abandoned.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Your sign's over the socket.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "My charger used to reach from here.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I was making room.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "For everybody except the microwave.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P03",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Oh, this looks much better.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Thanks for doing all this, Kreeb.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Where's my chair?",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I brought it over so people wouldn't have to sit alone.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "I was sitting alone on purpose.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "He was trying to be nice.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I noticed.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P04",
    "dialogueInline": [
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Is it fixed?",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "It will be when I fix it.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "These were not here last night.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I cleaned the shelves.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "You cleaned my shelf.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "That side's hotter than yesterday.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Good catch. Keep the bowl back.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "I'm getting out of the way.",
        "subtext": "Panel 6"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "That would help.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P05",
    "dialogueInline": [
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "There's room here. I made room.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I had room.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "You're putting it in the way.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Of what?",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Kreeb, leave the mug alone.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Oh, that's interesting.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Your elbow is on my tool.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Less interesting. Sorry.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "And I'd like the window back.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P06",
    "dialogueInline": [
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I'm sitting down, not joining anything.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "It's nicer if nobody has to eat by themselves.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Brick, if you name the bowl, I'm leaving.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I cleaned under that chair.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I'm trying to let him sit in it.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Enjoy the group.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Can everyone stop decorating the thing I'm repairing?",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I haven't had one spoonful.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P07",
    "dialogueInline": [
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Well, here's your heat problem.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Loose ground. No airflow. The notices sealed the vent.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Those were the safety notices.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "I can see that.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "I'm taking them down, not destroying them.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I only cleaned that counter an hour ago.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I'll move the chair.",
        "subtext": "Panel 6"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "That would be lovely.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P08",
    "dialogueInline": [
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I can take some of those.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "You've moved enough of my things today.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "You did all this last night?",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "That smell didn't leave by itself.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Glorp, I didn't realize—",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "No. You didn't.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I was trying to make it nicer.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "It was nice when I left.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P09",
    "dialogueInline": [
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Ground's good. Vent's clear. It's ready.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Ready as in lunch-ready?",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "That's usually what a microwave means.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I'm returning the tray.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "To where? It keeps changing.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I could use about twelve inches of counter.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Both of you, give him some room.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Never mind.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P10",
    "dialogueInline": [
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "This light is hostile.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "You're in front of the creamer.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "I'm keeping an eye on a possession dispute.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Then keep the other eye on my cup.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Brick. No case file.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "I've made no accusations.",
        "subtext": "Panel 6"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "You haven't moved, either.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P11",
    "dialogueInline": [
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I thought everybody would like having more room.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "You didn't ask anybody who was already using it.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "That includes me.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I didn't mean to take your place.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "You took the chair.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "And the mug.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I remember.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P12",
    "dialogueInline": [
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Just this little bit.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I missed a spot.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "Please don't get that one yet.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "That's a first.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "What is?",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Somebody asking me to leave the dirt.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Is my lunch in the specimen collection now?",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "Only if you put it there.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Mira",
        "speaker": "Mira Klare",
        "text": "All yours.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Thank you.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P13",
    "dialogueInline": [
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "You know it's working now.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "So I've been told.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "You could sit nearer everybody.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I could also finish lunch.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I was just trying to—",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I know. Everybody knows.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "This is why I kept the window.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P14",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Glorp, I brought you a new one.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "For tomorrow?",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "I thought it might help.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I'm not the break-room department.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "She was trying to be nice.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I've been told.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Fair enough.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P15",
    "dialogueInline": [
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Is this where you had it?",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Yes.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I thought the handle faced out.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "It faces me.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Could I have access to the kettle?",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Not a committee. Just a kettle.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "We really weren't trying to block it.",
        "subtext": "Panel 6"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "And yet.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P16",
    "dialogueInline": [
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I'm heating this before I'm old.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I haven't even pressed anything.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Then don't stop him.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I wasn't going to say anything.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "You raised a finger.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Please keep arguing. Over there.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "Congratulations on lunch.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P17",
    "dialogueInline": [
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Thanks.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I needed the chair clear.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "It's slipping.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I see it.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Is everything—",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Lunch.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Zib",
        "speaker": "Zib “Sgotcha” Diaz",
        "text": "It's still a microwave.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P18",
    "dialogueInline": [
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "There. Hot.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "A historic achievement.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Why is the counter talking?",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Oh.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "You sound pleased.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Nobody touch the printer.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P19",
    "dialogueInline": [
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I knew there'd be paperwork.",
        "subtext": "Panel 1"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Oh. The old microwave trigger's still connected.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Turn it off.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Wait. Don't tear that.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "She said turn it off, not throw it away.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Thank you.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Disconnected. You can still have lunch.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "I'm going to test that theory.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P20",
    "dialogueInline": [
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "It smelled better when it was cold.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "You're not having any.",
        "subtext": "Panel 2"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "May I put this here?",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "It's your chair.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "The tray can stay there.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "That's where I left it.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Pixa",
        "speaker": "Pixa",
        "text": "Creamer?",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Brick",
        "speaker": "Brick Talos",
        "text": "The investigation continues.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Could somebody pass the salt without forming a group?",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P21",
    "dialogueInline": [
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "I should've thanked you for yesterday.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Yes.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Astra",
        "speaker": "Astra Vega",
        "text": "Thank you.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "You're welcome.",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I'll get the table.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "There's a spot near the kettle.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Jax",
        "speaker": "Jax Orien",
        "text": "Not one drop wasted.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Noola",
        "speaker": "Noola Vaneel",
        "text": "You spilled it on your sleeve.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "I see it!",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E02_P22",
    "dialogueInline": [
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "Oh. We're labeling furniture now?",
        "subtext": "Panel 3"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Just this one.",
        "subtext": "Panel 4"
      },
      {
        "handle": "@sds.Glorp",
        "speaker": "Glorp",
        "text": "I'll get the laminator.",
        "subtext": "Panel 5"
      },
      {
        "handle": "@sds.Kreeb",
        "speaker": "Kreeb",
        "text": "Please don't.",
        "subtext": "Panel 5"
      }
    ]
  }
]
