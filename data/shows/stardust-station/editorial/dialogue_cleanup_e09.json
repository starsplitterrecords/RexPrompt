[
  {
    "id": "SDS_S1E09_P01",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "We're not chasing that number.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Benchmark attainment increases provisional-pilot confidence.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P03",
    "dialogueInline": [
      {
        "speaker": "ZIB",
        "text": "Don't move maintenance for that target.",
        "subtext": "Panel 2"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P04",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "No behavioral conditions. No invented incidents. No work whose only purpose is output.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "“Only purpose” leaves interpretive room.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "KREEB",
        "text": "Do you want interpretive room?",
        "subtext": "Panel 5"
      },
      {
        "speaker": "ASTRA",
        "text": "Close the loophole.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P06",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "Due tomorrow?",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ZIB",
        "text": "Tomorrow.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Can we do it today without displacing anything?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "It fits without displacing anything.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "Would you move it without the number?",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Probably not.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "ASTRA",
        "text": "One day early. Nothing else moves.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P08",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "Those are not the same result.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "You're still looking at them like they're one thing.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Because somebody made them one thing.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P11",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Procurement priority review remains favorable.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "Why are you looking at next week's problems today?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Because the target is getting into the schedule.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P18",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "Shuttle delay: eleven minutes.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "NOOLA",
        "text": "You wanted the bracket.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "I still do.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P20",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "I moved maintenance for the target.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "You did.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "It delayed actual work.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "Eleven minutes.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Do you want that written as cause and effect?",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Record it as cause and effect.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E09_P21",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "Defensible.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "Learning it cost us eleven minutes.",
        "subtext": "Panel 4"
      }
    ]
  }
]
