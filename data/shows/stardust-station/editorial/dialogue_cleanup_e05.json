[
  {
    "id": "SDS_S1E05_P02",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "RESOURCE-POSITIVE ENVIRONMENT / LOW-YIELD / HIGH-ANOMALY POTENTIAL.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "Low-yield. Finally, an insult I can verify.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Pilot sites receive expedited procurement eligibility.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "SCREEN",
        "text": "REPLACEMENT PART ETA: 18 DAYS.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "Don't look at me like I ordered the eighteen days.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P03",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "These came before lunch.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Pilot participation opens expedited procurement review.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ZIB",
        "text": "Review is still not a part.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "I also know what eighteen days looks like from here.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "Acceptance includes optional implementation fields.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "ASTRA",
        "text": "Write this down.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "ASTRA",
        "text": "Normal work only. Nobody creates work just to fill a bin.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P04",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "I signed the limited pilot.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "For the part.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "For the chance to ask about the part faster.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "That's worse, but at least it's honest.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Mass, cohesion, temperature, location—fine. “Staff condition” is not a measurement.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Can we answer the material question and leave people out of it?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "They may hate the answer.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Then we keep that conclusion.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P05",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "All right. What did I just get volunteered for?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Placement, custody, access, transfer.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "You can move anything that blocks real work.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "GLORP",
        "text": "There is a role charter.",
        "subtext": "Panel 6"
      },
      {
        "speaker": "JAX",
        "text": "You read that. I'll move the boxes.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P06",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Highest projected collection is here.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "NOOLA",
        "text": "Then I hit it twice a shift.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "With the dome or on purpose?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "NOOLA",
        "text": "First with the dome.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "And I need the panel behind her.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Then the recommendation is bad.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P07",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "“Context.” Context of what?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "Careful. That's how they get you.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Equipment and location I can defend. The rest is an invitation to invent.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "PIXA",
        "text": "I can hide the unused staff-condition prompt on this terminal.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "GLORP",
        "text": "Do it.",
        "subtext": "Panel 6"
      },
      {
        "speaker": "JAX",
        "text": "I was gone five minutes.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P08",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Current sample volume is below the review threshold.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "Because the station has had the nerve to behave normally.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Yesterday I would have called that good news.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "BRICK",
        "text": "Please do. The dashboard doesn't get to decide whether today was good.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P09",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "A busier location may improve collection coverage.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "Which location?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "The one in front of my panel.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Leaving the bin in place may delay baseline sufficiency.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Access wins. Keep the panel clear.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P10",
    "dialogueInline": [
      {
        "speaker": "MIRA",
        "text": "This one snaps. This one deforms. Same batch.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "You're smiling.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "I like weird material.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "PIXA",
        "text": "Suggested status: promising early indicator.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "'Promising' is doing too much work.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P11",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "Is there an honest way to make this move faster?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "Wait for something to break.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P12",
    "dialogueInline": [
      {
        "speaker": "ZIB",
        "text": "There. Something broke.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "You sounded almost happy.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "I've got a ticket. I'm happy.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "JAX",
        "text": "I've got access.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "MIRA",
        "text": "I've got temperature.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "And the sample stays where it is until the damper works.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ZIB",
        "text": "Hold that.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "ZIB",
        "text": "Now you can have your dust.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P13",
    "dialogueInline": [
      {
        "speaker": "JAX",
        "text": "Seal intact. Time logged. Nobody cried into it.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Excellent chain of custody.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "Repeat the test.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "It already survived once.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "Once is interesting. Do it again.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "Do we know why it held?",
        "subtext": "Panel 5"
      },
      {
        "speaker": "MIRA",
        "text": "Not remotely.",
        "subtext": "Panel 6"
      },
      {
        "speaker": "ASTRA",
        "text": "You're still smiling.",
        "subtext": "Panel 6"
      },
      {
        "speaker": "MIRA",
        "text": "Now I have a question.",
        "subtext": "Panel 6"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P14",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Expedited procurement review is now available.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "The part?",
        "subtext": "Panel 1"
      },
      {
        "speaker": "PIXA",
        "text": "Still eighteen days.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "So we unlocked the privilege of asking sooner.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "We can ask faster. That's all.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "You're terrible at celebrating.",
        "subtext": "Panel 3"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P15",
    "dialogueInline": [
      {
        "speaker": "GLORP",
        "text": "Astra. Do not close that screen.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "GLORP",
        "text": "These are marked optional.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Declining them may reduce pilot eligibility.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "GLORP",
        "text": "Then they're not really optional.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "KREEB",
        "text": "That's coercive.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "At least we all hate the same thing.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "JAX",
        "text": "Routes, seals, and pickups are assigned.",
        "subtext": "Panel 5"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P16",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "No speeches. What do we actually keep?",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ZIB",
        "text": "The maintenance part.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "The measurements.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "KREEB",
        "text": "Anything people opt into.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Passive custody. No behavior fields.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "JAX",
        "text": "Routes, seals, pickups.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "That's enough.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P17",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "PASSIVE MATERIAL COLLECTION: APPROVED.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ASTRA",
        "text": "Keep that.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "SCREEN",
        "text": "BEHAVIORAL ENHANCEMENT: NOT APPROVED.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "Future eligibility may be reduced.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "GLORP",
        "text": "Then the eligibility penalty belongs in the risk log.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P18",
    "dialogueInline": [
      {
        "speaker": "SCREEN",
        "text": "BOUNDARY RECEIVED.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "SCREEN",
        "text": "PILOT ELIGIBILITY: PENDING BASELINE.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Baseline of what?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "SCREEN",
        "text": "STANDARD WELLNESS BASELINE WEEK.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "Same idea. Nicer font.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "Company policy. Different refusal process.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "ASTRA",
        "text": "There's a refusal process?",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "It exists, but it is buried in company policy.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P19",
    "dialogueInline": [
      {
        "speaker": "ASTRA",
        "text": "So they got a week.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "MIRA",
        "text": "They did not get the intervention they asked for.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "They got chairs and a schedule.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "MIRA",
        "text": "And we get room conditions.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "ASTRA",
        "text": "You're enjoying this.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "MIRA",
        "text": "I dislike the premise. The airflow data is useful.",
        "subtext": "Panel 4"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P20",
    "dialogueInline": [
      {
        "speaker": "PIXA",
        "text": "Submission complete.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "JAX",
        "text": "No emotional fields snuck in while I wasn't looking?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "The submission contains only operational fields.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Why are there two signs?",
        "subtext": "Panel 4"
      },
      {
        "speaker": "GLORP",
        "text": "There should not be.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "KREEB",
        "text": "That was fast.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "GLORP",
        "text": "Two instructions. One rack.",
        "subtext": "Panel 6"
      },
      {
        "speaker": "KREEB",
        "text": "Keep access first.",
        "subtext": "Panel 6"
      },
      {
        "speaker": "KREEB",
        "text": "I was prepared to argue.",
        "subtext": "Panel 7"
      },
      {
        "speaker": "GLORP",
        "text": "Try again tomorrow.",
        "subtext": "Panel 7"
      }
    ]
  },
  {
    "id": "SDS_S1E05_P21",
    "dialogueInline": [
      {
        "speaker": "SIGN",
        "text": "WELLNESS BASELINE WEEK BEGINS MONDAY.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "ZIB",
        "text": "Can I move that?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "PIXA",
        "text": "It's not blocking maintenance.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ZIB",
        "text": "It's blocking my view of the clock.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "ASTRA",
        "text": "Nobody touch it until Monday.",
        "subtext": "Panel 3"
      }
    ]
  }
]
