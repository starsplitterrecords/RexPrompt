    "dialogueInline": [
      {
        "handle": "@vik.HearingOfficer",
        "text": "Where do you go without Ms. Carrie?"
      },
      {
        "handle": "@vik.KinMan1",
        "text": "Laundry. Bodega. Building. Park if it's nice."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "Why?"
      },
      {
        "handle": "@vik.KinMan1",
        "text": "Things need doing. People notice if you say you'll come back and don't."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "Would you leave the neighborhood?"
      },
      {
        "handle": "@vik.KinMan1",
        "text": "I'd rather not."
      }
    ],
