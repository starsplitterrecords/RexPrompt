    "dialogueInline": [
      {
        "handle": "@vik.HearingOfficer",
        "text": "Where do you go without your caseworker?"
      },
      {
        "handle": "@vik.KinMan1",
        "text": "Laundry. Store. Building. Sometimes park."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "Why those places?"
      },
      {
        "handle": "@vik.KinMan1",
        "text": "Clothes become dirty. Food becomes gone. People expect you when you say you come back."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "And if you had to leave the neighborhood?"
      },
      {
        "handle": "@vik.KinMan1",
        "text": "I would not want to."
      }
    ],
    "page": 7
  },
