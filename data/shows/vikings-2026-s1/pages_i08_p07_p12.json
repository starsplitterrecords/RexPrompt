    "dialogueInline": [
      {
        "handle": "@vik.HearingOfficer",
        "text": "Do you intend to remain in New York permanently?"
      },
      {
        "handle": "@vik.KinMan2",
        "text": "I intend to remain."
      },
      {
        "handle": "@vik.KinMan2",
        "text": "I do not promise forever."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "Those are different statements."
      },
      {
        "handle": "@vik.KinMan2",
        "text": "Yes."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "Good. I wanted to know if you understood that."
      }
    ],
