    "dialogueInline": [
      {
        "handle": "@vik.HearingOfficer",
        "text": "Mr. Bjorn, the record still gives you authority the people beside you say you do not have."
      },
      {
        "handle": "@vik.Bjorn",
        "text": "It gave me responsibility."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "For this case, those are the same box. If I correct it, you no longer answer for them."
      },
      {
        "handle": "@vik.Bjorn",
        "text": "Then correct it."
      },
      {
        "handle": "@vik.HearingOfficer",
        "text": "I am."
      }
