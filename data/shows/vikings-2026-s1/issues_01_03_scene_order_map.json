      "currentId": "VIK_S1I01_P10",
      "title": "At dusk, the DTI van delivers Bjorn and Gunnar to the Municipal Department of Temporal Integration; they approach the entrance as if it were a formal trial."
    },
    {
      "sourceFile": "encoded/pages_e01_*.json.gzb64 or pages_e01_insert_after_p15.json",
