      "currentId": "VIK_S1I01_P08",
      "title": "The DTI agent fits Bjorn with a fluorescent intake wristband; Bjorn interprets it as a fragile parley token."
    },
    {
      "sourceFile": "encoded/pages_e01_*.json.gzb64 or pages_e01_insert_after_p15.json",
