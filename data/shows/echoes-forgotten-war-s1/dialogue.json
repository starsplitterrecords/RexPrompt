{
  "D_EFW_E01_S01_01": {"speakerId": "EFW_Vark", "text": "Shift's over."},
  "D_EFW_E01_S01_02": {"speakerId": "EFW_Theo", "text": "Not yet."},
  "D_EFW_E01_S01_03": {"speakerId": "EFW_Vark", "text": "You said that an hour ago."},
  "D_EFW_E01_S01_04": {"speakerId": "EFW_Theo", "text": "There's something under us."},
  "D_EFW_E01_S01_05": {"speakerId": "EFW_Vark", "text": "There is rock under us. That's the job."},
  "D_EFW_E01_S01_06": {"speakerId": "EFW_Theo", "text": "I've seen what comes next."},
  "D_EFW_E01_S01_07": {"speakerId": "EFW_Vark", "text": "In the survey?"},
  "D_EFW_E01_S01_08": {"speakerId": "EFW_Theo", "text": "No."},
  "D_EFW_E01_S01_09": {"speakerId": "EFW_Vark", "text": "Theo."},
  "D_EFW_E01_S01_10": {"speakerId": "EFW_Theo", "text": "That's it."},

  "D_EFW_E01_S02_01": {"speakerId": "EFW_Caelum", "text": "What happened at Olyria-Prime?"},
  "D_EFW_E01_S02_02": {"speakerId": "EFW_Rae", "text": "The report says a mining accident."},
  "D_EFW_E01_S02_03": {"speakerId": "EFW_Caelum", "text": "I didn't ask what the report says."},
  "D_EFW_E01_S02_04": {"speakerId": "EFW_Rae", "text": "Then you should ask the people who wrote it."},
  "D_EFW_E01_S02_05": {"speakerId": "EFW_Caelum", "text": "You look ill."},
  "D_EFW_E01_S02_06": {"speakerId": "EFW_Rae", "text": "I work nights."},
  "D_EFW_E01_S02_07": {"speakerId": "EFW_Caelum", "text": "Move."},
  "D_EFW_E01_S02_08": {"speakerId": "EFW_Rae", "text": "You wanted the freight manifests."},
  "D_EFW_E01_S02_09": {"speakerId": "EFW_Caelum", "text": "I want the screen behind you."},
  "D_EFW_E01_S02_10": {"speakerId": "EFW_Rae", "text": "That's a different request."},

  "D_EFW_E01_S03_01": {"speakerId": "EFW_Vark", "text": "I am not dragging you home by your ankles."},
  "D_EFW_E01_S03_02": {"speakerId": "EFW_Theo", "text": "Then don't."},
  "D_EFW_E01_S03_03": {"speakerId": "EFW_Vark", "text": "You dreamed this?"},
  "D_EFW_E01_S03_04": {"speakerId": "EFW_Theo", "text": "Every night."},
  "D_EFW_E01_S03_05": {"speakerId": "EFW_Vark", "text": "And that makes touching it a good idea?"},
  "D_EFW_E01_S03_06": {"speakerId": "EFW_Theo", "text": "No."},
  "D_EFW_E01_S03_07": {"speakerId": "EFW_Vark", "text": "Good. We agree on something."},
  "D_EFW_E01_S03_08": {"speakerId": "EFW_Theo", "text": "It makes not touching it impossible."},
  "D_EFW_E01_S03_09": {"speakerId": "EFW_Starbreaker", "text": "You know what happens if I do."},

  "D_EFW_E01_S04_01": {"speakerId": "EFW_Theo", "text": "Tell me you see it."},
  "D_EFW_E01_S04_02": {"speakerId": "EFW_Adrian", "text": "I see you bleeding."},
  "D_EFW_E01_S04_03": {"speakerId": "EFW_Theo", "text": "Look at it."},
  "D_EFW_E01_S04_04": {"speakerId": "EFW_Adrian", "text": "I don't need to."},
  "D_EFW_E01_S04_05": {"speakerId": "EFW_Theo", "text": "Then you know what it is."},
  "D_EFW_E01_S04_06": {"speakerId": "EFW_Adrian", "text": "I know what follows recognition."},
  "D_EFW_E01_S04_07": {"speakerId": "EFW_Theo", "text": "I've been seeing this place for years."},
  "D_EFW_E01_S04_08": {"speakerId": "EFW_Adrian", "text": "Not this place."},
  "D_EFW_E01_S04_09": {"speakerId": "EFW_Theo", "text": "No."},
  "D_EFW_E01_S04_10": {"speakerId": "EFW_Adrian", "text": "How long?"},
  "D_EFW_E01_S04_11": {"speakerId": "EFW_Theo", "text": "Since I was a child."},
  "D_EFW_E01_S04_12": {"speakerId": "EFW_Adrian", "text": "Then we're late."},
  "D_EFW_E01_S04_13": {"speakerId": "EFW_Theo", "text": "Starbreaker was real?"},
  "D_EFW_E01_S04_14": {"speakerId": "EFW_Adrian", "text": "Yes."},

  "D_EFW_E01_S05_01": {"speakerId": "EFW_Caelum", "text": "Step away."},
  "D_EFW_E01_S05_02": {"speakerId": "EFW_Rae", "text": "I can't."},
  "D_EFW_E01_S05_03": {"speakerId": "EFW_Caelum", "text": "You mean you won't."},
  "D_EFW_E01_S05_04": {"speakerId": "EFW_Rae", "text": "No. I mean I can't leave it here."},
  "D_EFW_E01_S05_05": {"speakerId": "EFW_Caelum", "text": "You have a life in this Spire."},
  "D_EFW_E01_S05_06": {"speakerId": "EFW_Rae", "text": "Then tell me why that place was erased."},
  "D_EFW_E01_S05_07": {"speakerId": "EFW_Caelum", "text": "Give me the drive."},
  "D_EFW_E01_S05_08": {"speakerId": "EFW_Rae", "text": "Tell me its name."},
  "D_EFW_E01_S05_09": {"speakerId": "EFW_Caelum", "text": "Rae."},
  "D_EFW_E01_S05_10": {"speakerId": "EFW_Rae", "text": "You know it too."},
  "D_EFW_E01_S05_11": {"speakerId": "EFW_Rae", "text": "Redlin."},

  "D_EFW_E01_S06_01": {"speakerId": "EFW_Vark", "text": "You want me to write 'chemical fire.'"},
  "D_EFW_E01_S06_02": {"speakerId": "EFW_Theo", "text": "Yes."},
  "D_EFW_E01_S06_03": {"speakerId": "EFW_Vark", "text": "There was no chemical fire."},
  "D_EFW_E01_S06_04": {"speakerId": "EFW_Theo", "text": "Then make one up."},
  "D_EFW_E01_S06_05": {"speakerId": "EFW_Vark", "text": "I spent twenty years keeping idiots from lying on incident reports."},
  "D_EFW_E01_S06_06": {"speakerId": "EFW_Theo", "text": "Today can be your retirement party."},
  "D_EFW_E01_S06_07": {"speakerId": "EFW_Vark", "text": "I hate cake."},
  "D_EFW_E01_S06_08": {"speakerId": "EFW_Theo", "text": "Vark."},
  "D_EFW_E01_S06_09": {"speakerId": "EFW_Vark", "text": "I saw the sky change."},
  "D_EFW_E01_S06_10": {"speakerId": "EFW_Theo", "text": "So did I."},
  "D_EFW_E01_S06_11": {"speakerId": "EFW_Vark", "text": "That's why I'm lying."},

  "D_EFW_E01_S07_01": {"speakerId": "EFW_Rae", "text": "You're in my archive."},
  "D_EFW_E01_S07_02": {"speakerId": "EFW_Adrian", "text": "Not this part."},
  "D_EFW_E01_S07_13": {"speakerId": "EFW_Rae", "text": "Redlin."},
  "D_EFW_E01_S07_03": {"speakerId": "EFW_Rae", "text": "You know what's on this."},
  "D_EFW_E01_S07_04": {"speakerId": "EFW_Adrian", "text": "Enough to know you should destroy it."},
  "D_EFW_E01_S07_05": {"speakerId": "EFW_Rae", "text": "That's convenient."},
  "D_EFW_E01_S07_06": {"speakerId": "EFW_Adrian", "text": "Convenience has nothing to do with it."},
  "D_EFW_E01_S07_07": {"speakerId": "EFW_Rae", "text": "Why was the record erased?"},
  "D_EFW_E01_S07_08": {"speakerId": "EFW_Adrian", "text": "Because some histories were not lost."},
  "D_EFW_E01_S07_09": {"speakerId": "EFW_Rae", "text": "What does that mean?"},
  "D_EFW_E01_S07_10": {"speakerId": "EFW_Adrian", "text": "They were removed."},
  "D_EFW_E01_S07_11": {"speakerId": "EFW_Rae", "text": "By whom?"},
  "D_EFW_E01_S07_12": {"speakerId": "EFW_Adrian", "text": "By people who remembered what happened when they stayed."},

  "D_EFW_E01_S08_01": {"speakerId": "EFW_Theo", "text": "They're coming."},
  "D_EFW_E01_S08_02": {"speakerId": "EFW_Adrian", "text": "Yes."},
  "D_EFW_E01_S08_03": {"speakerId": "EFW_Theo", "text": "Help me."},
  "D_EFW_E01_S08_04": {"speakerId": "EFW_Adrian", "text": "You spent years wanting proof."},
  "D_EFW_E01_S08_05": {"speakerId": "EFW_Theo", "text": "I have it."},
  "D_EFW_E01_S08_06": {"speakerId": "EFW_Adrian", "text": "And now?"},
  "D_EFW_E01_S08_07": {"speakerId": "EFW_Theo", "text": "Now I don't want them to have it."},
  "D_EFW_E01_S08_08": {"speakerId": "EFW_Adrian", "text": "Good."},
  "D_EFW_E01_S08_09": {"speakerId": "EFW_Theo", "text": "You could have helped five minutes ago."},
  "D_EFW_E01_S08_10": {"speakerId": "EFW_Adrian", "text": "Five minutes ago you were still deciding what it belonged to."},

  "D_EFW_E01_S09_01": {"speakerId": "EFW_Caelum", "text": "You can still give it to me."},
  "D_EFW_E01_S09_02": {"speakerId": "EFW_Rae", "text": "And you'll do what?"},
  "D_EFW_E01_S09_03": {"speakerId": "EFW_Caelum", "text": "What keeps this place standing."},
  "D_EFW_E01_S09_04": {"speakerId": "EFW_Rae", "text": "You already erased it once."},
  "D_EFW_E01_S09_05": {"speakerId": "EFW_Caelum", "text": "You don't know that."},
  "D_EFW_E01_S09_06": {"speakerId": "EFW_Rae", "text": "Neither do you. That's the problem."},
  "D_EFW_E01_S09_07": {"speakerId": "EFW_Caelum", "text": "Everything you have is here."},
  "D_EFW_E01_S09_08": {"speakerId": "EFW_Rae", "text": "No. Everything I have is what I remember."},
  "D_EFW_E01_S09_09": {"speakerId": "EFW_Caelum", "text": "They can take that too."},
  "D_EFW_E01_S09_10": {"speakerId": "EFW_Rae", "text": "Then I should leave before they try."},

  "D_EFW_E01_S10_01": {"speakerId": "EFW_Adrian", "text": "If you're going to threaten me, point it at me."},
  "D_EFW_E01_S10_02": {"speakerId": "EFW_Theo", "text": "I am."},
  "D_EFW_E01_S10_03": {"speakerId": "EFW_Adrian", "text": "No. You're watching the grave."},
  "D_EFW_E01_S10_04": {"speakerId": "EFW_Theo", "text": "Swear you didn't keep the location."},
  "D_EFW_E01_S10_05": {"speakerId": "EFW_Adrian", "text": "You still think the location is the danger."},
  "D_EFW_E01_S10_06": {"speakerId": "EFW_Theo", "text": "What is?"},
  "D_EFW_E01_S10_07": {"speakerId": "EFW_Adrian", "text": "Recognition."},
  "D_EFW_E01_S10_08": {"speakerId": "EFW_Theo", "text": "What recognized me?"},
  "D_EFW_E01_S10_09": {"speakerId": "EFW_Adrian", "text": "That's the question."},
  "D_EFW_E01_S10_10": {"speakerId": "EFW_Theo", "text": "You know."},
  "D_EFW_E01_S10_11": {"speakerId": "EFW_Adrian", "text": "I know what it resembles."},
  "D_EFW_E01_S10_12": {"speakerId": "EFW_Theo", "text": "What?"},
  "D_EFW_E01_S10_13": {"speakerId": "EFW_Adrian", "text": "A beginning."},

  "D_EFW_E01_S11_01": {"speakerId": "EFW_Adrian", "text": "You burned it."},
  "D_EFW_E01_S11_02": {"speakerId": "EFW_Rae", "text": "You told me to destroy the copy."},
  "D_EFW_E01_S11_03": {"speakerId": "EFW_Adrian", "text": "I did."},
  "D_EFW_E01_S11_04": {"speakerId": "EFW_Rae", "text": "I destroyed the trail."},
  "D_EFW_E01_S11_05": {"speakerId": "EFW_Adrian", "text": "That was your life."},
  "D_EFW_E01_S11_06": {"speakerId": "EFW_Rae", "text": "No. It was my job."},
  "D_EFW_E01_S11_07": {"speakerId": "EFW_Adrian", "text": "The distinction matters now."},
  "D_EFW_E01_S11_08": {"speakerId": "EFW_Rae", "text": "Where do I go?"},
  "D_EFW_E01_S11_09": {"speakerId": "EFW_Adrian", "text": "Somewhere you've never dreamed of."},
  "D_EFW_E01_S11_10": {"speakerId": "EFW_Rae", "text": "How do you know about the dreams?"},
  "D_EFW_E01_S11_11": {"speakerId": "EFW_Adrian", "text": "Because you aren't the first."},

  "D_EFW_E01_S12_01": {"speakerId": "EFW_Theo", "text": "They said the dreams were mine."},
  "D_EFW_E01_S12_02": {"speakerId": "EFW_Adrian", "text": "They are."},
  "D_EFW_E01_S12_03": {"speakerId": "EFW_Theo", "text": "You know what I mean."},
  "D_EFW_E01_S12_04": {"speakerId": "EFW_Adrian", "text": "Yes."},
  "D_EFW_E01_S12_05": {"speakerId": "EFW_Theo", "text": "Then tell me whose memory it is."},
  "D_EFW_E01_S12_06": {"speakerId": "EFW_Adrian", "text": "I can't."},
  "D_EFW_E01_S12_07": {"speakerId": "EFW_Theo", "text": "Won't."},
  "D_EFW_E01_S12_08": {"speakerId": "EFW_Adrian", "text": "Both."},
  "D_EFW_E01_S12_09": {"speakerId": "EFW_Theo", "text": "You heard it too."},
  "D_EFW_E01_S12_10": {"speakerId": "EFW_Adrian", "text": "Put the shard down."},
  "D_EFW_E01_S12_11": {"speakerId": "EFW_Theo", "text": "You knew what the sky sounded like."},
  "D_EFW_E01_S12_12": {"speakerId": "EFW_Adrian", "text": "There are no canopies left to fracture."},
  "D_EFW_E01_S12_13": {"speakerId": "EFW_Theo", "text": "But you remember them."},
  "D_EFW_E01_S12_14": {"speakerId": "EFW_Adrian", "text": "Yes."}
}
