[
  {
    "id": "AZR_S1E06_P03",
    "dialogueInline": [
      {
        "speaker": "Julian Heatherington",
        "handle": "@azr.Julian",
        "text": "That's my shot.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Fleur Fontaine",
        "handle": "@azr.Fleur",
        "text": "That's my light.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Nia Patel",
        "handle": "@azr.Nia",
        "text": "That's the way people get to the water.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Julian Heatherington",
        "handle": "@azr.Julian",
        "text": "Your projection could go higher.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Fleur Fontaine",
        "handle": "@azr.Fleur",
        "text": "And your face could go somewhere else.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "You both made this look wonderful on paper.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Nia Patel",
        "handle": "@azr.Nia",
        "text": "A stroller can't get through either setup.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "Fine. Show me the room without either of you in front of it.",
        "subtext": "Panel 5"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  },
  {
    "id": "AZR_S1E06_P04",
    "dialogueInline": [
      {
        "speaker": "Elliot",
        "handle": "@azr.Elliot",
        "text": "We promised the sponsor recognition, the awards and accessible hospitality.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Beatrice",
        "handle": "@azr.Beatrice",
        "text": "Only those three?",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Elliot",
        "handle": "@azr.Elliot",
        "text": "Everything else is in our own presentation.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Fleur",
        "handle": "@azr.Fleur",
        "text": "Even the huge photo wall?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Elliot",
        "handle": "@azr.Elliot",
        "text": "Especially the huge photo wall.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Julian",
        "handle": "@azr.Julian",
        "text": "My opening speech?",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Elliot",
        "handle": "@azr.Elliot",
        "text": "I am afraid that is also entirely voluntary.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Beatrice",
        "handle": "@azr.Beatrice",
        "text": "I may enjoy this more than I expected.",
        "subtext": "Panel 5"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  },
  {
    "id": "AZR_S1E06_P08",
    "dialogueInline": [
      {
        "speaker": "Raf",
        "handle": "@azr.Raf",
        "text": "If everybody sits through dinner, nobody gets to see the water.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Beatrice",
        "handle": "@azr.Beatrice",
        "text": "People do enjoy a formal dinner.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Raf",
        "handle": "@azr.Raf",
        "text": "Then let them sit. And let them get up.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Nia",
        "handle": "@azr.Nia",
        "text": "There's room for seating around the edge.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Pip",
        "handle": "@azr.Pip",
        "text": "And a lot of room to enjoy the view.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Beatrice",
        "handle": "@azr.Beatrice",
        "text": "Are we still calling this a gala?",
        "subtext": "Panel 5"
      },
      {
        "speaker": "Raf",
        "handle": "@azr.Raf",
        "text": "With these prices? Absolutely.",
        "subtext": "Panel 5"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  },
  {
    "id": "AZR_S1E06_P13",
    "dialogueInline": [
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "Pen.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Julian Heatherington",
        "handle": "@azr.Julian",
        "text": "I was hoping you'd use the other end.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Fleur Fontaine",
        "handle": "@azr.Fleur",
        "text": "There goes my photo stop.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "And the second live hit.",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Nia Patel",
        "handle": "@azr.Nia",
        "text": "What goes there now?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "The reef.",
        "subtext": "Panel 4"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  },
  {
    "id": "AZR_S1E06_P14",
    "dialogueInline": [
      {
        "speaker": "Staff Educator",
        "handle": "@azr.Educator",
        "text": "What do you notice first?",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Julian Heatherington",
        "handle": "@azr.Julian",
        "text": "I—",
        "subtext": "Panel 2"
      },
      {
        "speaker": "Fleur Fontaine",
        "handle": "@azr.Fleur",
        "text": "Julian?",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Julian Heatherington",
        "handle": "@azr.Julian",
        "text": "Just... wait.",
        "subtext": "Panel 3"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  },
  {
    "id": "AZR_S1E06_P18",
    "dialogueInline": [
      {
        "speaker": "Kyler Chen",
        "handle": "@azr.Kyler",
        "text": "Main display's gone dark.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Julian Heatherington",
        "handle": "@azr.Julian",
        "text": "Awards in twenty seconds.",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Fleur Fontaine",
        "handle": "@azr.Fleur",
        "text": "Use the approved Conservation Wall feed.",
        "subtext": "Panel 3"
      },
      {
        "speaker": "Kyler Chen",
        "handle": "@azr.Kyler",
        "text": "I have it.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Pip O'Mally",
        "handle": "@azr.Pip",
        "text": "Guests are still watching the reef.",
        "subtext": "Panel 5"
      },
      {
        "speaker": "Kyler Chen",
        "handle": "@azr.Kyler",
        "text": "The main image is back.",
        "subtext": "Panel 6"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  },
  {
    "id": "AZR_S1E06_P20",
    "dialogueInline": [
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "Before we—",
        "subtext": "Panel 1"
      },
      {
        "speaker": "Beatrice Halstead",
        "handle": "@azr.Beatrice",
        "text": "Maya. Sal. Come here.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Maya Serrano",
        "handle": "@azr.Maya",
        "text": "Absolutely not.",
        "subtext": "Panel 4"
      },
      {
        "speaker": "Sal Delgado",
        "handle": "@azr.Sal",
        "text": "Too late.",
        "subtext": "Panel 4"
      }
    ],
    "dialogueSource": "Azure Reach Issue 6 editorial C: panel balloon order and voice pass"
  }
]
